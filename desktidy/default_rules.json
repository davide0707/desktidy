{
  "_house_rules": "Names starting with ! are never touched. Nothing is moved until the house rules are accepted and at least pinned_folders.min_required folders are pinned (desktidy setup). Every move is logged (desktidy where) and can be undone (desktidy undo).",
  "_how_it_works": "Decision order (all offline, free, nothing sent): 0) PINNED folders; 1) NAME words (exact, then plural/singular, then one typo); 2) CONTENT: content_words (strong), topics (at least min_topics, usually 2-3), recognize (kinds DeskTidy understands: photo, screenshot, icon, scan, code_python, code_c, code_web, code_shell, code_sql, project_code, project_python, project_web, project_stm32, project_kicad, gerber, print_3d, font, installer, photo_folder, audio_folder, video_folder); 3) SIMILARITY with the files already in each folder; 4) FILE TYPE (extensions). The AI is asked only as ai.mode allows. Private rules never leave the computer. Programs only go to {INSTALLERS}. This file reloads by itself.",
  "_variables": "Always defined, on Windows, macOS and Linux: {HOME}, {DOCS}, {DOWNLOADS}, {DESKTOP}, {PICTURES}, {VIDEOS}, {MUSIC} (the real user folders, also when they are moved or have another name, e.g. Documenti). Write paths with / (a rules.json written with \\ works too, on every system).",
  "variables": {
    "STUDY": "{DOCS}/01_Study",
    "INSTALLERS": "{DOCS}/05_Software/Installers"
  },
  "interval_seconds": 30,
  "watched_folders": [
    { "path": "{DOWNLOADS}", "wait_seconds": 120, "include_folders": true },
    { "path": "{DESKTOP}", "wait_seconds": 600, "include_folders": false },
    { "path": "{DOCS}", "wait_seconds": 600, "include_folders": false, "ignore": [] }
  ],
  "default_destination": "{DOCS}/00_Inbox/To_Sort",
  "analysis": { "ocr": true, "similarity": true },
  "rename": { "mode": "smart" },
  "pinned_folders": { "min_required": 2, "ask": true, "ask_for_new_folders_in": ["{DESKTOP}"], "wait_seconds": 60 },
  "limits": {
    "_note": "files_per_day: how many files DeskTidy may tidy per day, AI or not: a number or \"unlimited\" (desktidy limit 30 | unlimited). The AI has its own limit: ai.max_files_per_day (desktidy ai max 50 | unlimited).",
    "files_per_day": "unlimited"
  },
  "search": { "_note": "desktidy find <words>: local full-text index of the tidied documents (index.db, never sent anywhere).", "enabled": true, "index_private": true },
  "deadlines": { "_note": "Payment and submission dates found in documents; reminders this many days before (0 = on the day).", "enabled": true, "remind_days": [7, 1, 0] },
  "archive": {
    "_note": "Items untouched for after_days on the Desktop and in the to-sort folder go to folder/<year> (desktidy archive on). zip = compress each item.",
    "enabled": false, "after_days": 180, "folder": "{DOCS}/Archive", "zip": false,
    "sources": ["{DESKTOP}", "{DOCS}/00_Inbox/To_Sort"]
  },
  "import": {
    "_note": "Memory cards with a DCIM folder: photos and videos copied by date (pattern: {year} {month} {day}). auto = without asking.",
    "enabled": true, "auto": false, "photos": "{PICTURES}", "videos": "{VIDEOS}",
    "pattern": "{year}/{year}-{month}", "delete_after": false
  },
  "learn": { "_note": "Corrections (files you moved yourself) needed before a rule is proposed, and files the AI put in the same folder (left there 3 days) before a rule is proposed from them (desktidy learn).", "min_examples": 2, "min_ai_examples": 5 },
  "groups": { "_note": "Files with something in common needed to propose a group of the to-sort pile (desktidy groups).", "min_files": 3 },
  "organize": { "_note": "Loose items that make a folder crowded (desktidy organize).", "min_items": 10 },
  "duplicates": { "_note": "Smaller files are not compared (desktidy duplicates).", "min_size_kb": 512 },
  "summary": { "_note": "The weekly summary notification (desktidy week): weekly true/false, day monday...sunday.", "weekly": true, "day": "monday" },
  "tray": true,
  "updates": { "_note": "Once a week, one anonymous request to GitHub for the latest version.", "check": true },
  "ai": {
    "_note": "provider: groq (free) | gemini (free tier) | mistral (free plan) | openrouter (free models) | ollama (free, on this PC) | claude | openai | custom. Change it with: desktidy ai provider, then: desktidy key. mode: off | limited (files the offline engine can't place, 10/day) | moderate (also low-confidence ones, 30/day) | ai-only (every non-private file, 100/day; also fixes names that don't match the content and suggests a better organisation: desktidy advice) | all (always AI: every file, private documents too, named by the AI, 100/day; photos and screenshots stay offline). redact: true = IBANs, card numbers, tax codes, VAT numbers, e-mails and phone numbers are masked before anything goes to a service on the internet (never needed for Ollama). model: empty = the provider's default. delivery: batch (Claude only, half price, minutes) | instant. gather_seconds: files for the AI wait up to this long to share one request (90). advice: auto (ai-only and all modes) | on | off; advice_after_files (30), advice_every_days (7), language (empty = the language of your folder names).",
    "provider": "groq",
    "mode": "limited",
    "redact": true,
    "delivery": "batch",
    "gather_seconds": 90,
    "advice": "auto",
    "budget_usd": 5.0,
    "credit_reserve_usd": 0.10,
    "min_confidence": "high",
    "max_folders_per_file": 30,
    "user_context": "",
    "candidate_folders": [
      { "path": "{DOCS}/00_Inbox", "depth": 1 },
      { "path": "{STUDY}", "depth": 3 },
      { "path": "{DOCS}/02_Work", "depth": 2 },
      { "path": "{DOCS}/03_Projects", "depth": 2 },
      { "path": "{DOCS}/04_Personal", "depth": 2 },
      { "path": "{DOCS}/05_Software", "depth": 2 },
      { "path": "{VIDEOS}", "depth": 1 }
    ]
  },
  "rules": [
    {
      "name": "Installers: electronics",
      "type": "both",
      "extensions": [".exe", ".msi", ".msix", ".dmg", ".pkg", ".deb", ".rpm", ".appimage", ".zip", ".7z", ".rar", ".uf2"],
      "name_words": ["stm32", "stlink", "st link", "stm32cube", "cubeide", "cubemx", "arduino", "cp210x", "ch340", "ftdi",
                     "multisim", "labview", "ltspice", "kicad", "packet tracer", "rpi pico", "esp32", "esp idf",
                     "platformio", "proteus", "fritzing", "altium", "eagle", "logisim", "quartus", "vivado", "keil",
                     "segger", "jlink", "teraterm", "coolterm"],
      "destination": "{INSTALLERS}/Electronics"
    },
    {
      "name": "Installers: network and security",
      "type": "both",
      "extensions": [".exe", ".msi", ".msix", ".dmg", ".pkg", ".deb", ".rpm", ".appimage", ".zip", ".7z", ".rar"],
      "name_words": ["vpn", "nordvpn", "protonvpn", "openvpn", "wireguard", "tailscale", "zerotier", "wireshark", "npcap",
                     "nmap", "zenmap", "mosquitto", "mqttx", "tor browser", "burp", "metasploit", "angry ip",
                     "advanced ip scanner", "filezilla", "winscp", "hashcat", "ghidra"],
      "destination": "{INSTALLERS}/Network_and_Security"
    },
    {
      "name": "Installers: development",
      "type": "both",
      "extensions": [".exe", ".msi", ".msix", ".dmg", ".pkg", ".deb", ".rpm", ".appimage", ".zip", ".7z", ".rar"],
      "name_words": ["git", "github cli", "node", "nodejs", "python", "cmake", "vscode", "vs code", "vscodeusersetup",
                     "visual studio", "jetbrains", "pycharm", "intellij", "clion", "sqlite", "db browser", "postman",
                     "dotnet", "jdk", "java", "msys2", "mingw", "llvm", "android studio", "putty", "anaconda",
                     "miniconda", "rustup", "golang", "ollama", "cursor", "notepad"],
      "destination": "{INSTALLERS}/Development"
    },
    {
      "name": "Operating systems and virtual machines",
      "type": "both",
      "extensions": [".7z", ".zip", ".rar", ".xz", ".gz", ".torrent"],
      "name_words": ["kali", "ubuntu", "debian", "fedora", "linux mint", "archlinux", "arch linux", "hyper v", "vmware",
                     "virtualbox", "win11", "windows 11 iso"],
      "destination": "{INSTALLERS}/Virtual_Machines"
    },
    {
      "name": "Portable apps",
      "extensions": [".zip", ".7z", ".rar"],
      "name_words": ["portable", "portabile"],
      "destination": "{DOCS}/05_Software/Portable"
    },
    {
      "name": "Study: maths",
      "type": "both",
      "name_words": ["calculus", "analisi 1", "analisi matematica", "linear algebra", "algebra lineare", "geometria"],
      "content_words": ["calculus", "analisi matematica", "linear algebra", "algebra lineare"],
      "topics": ["derivative", "derivata", "integral", "integrale", "limit", "limite", "theorem", "teorema", "proof",
                 "dimostrazione", "series", "serie", "matrix", "matrice", "eigenvalue", "autovalore", "differential equation",
                 "equazione differenziale", "taylor", "asymptote", "asintoto", "continuity", "continuita"],
      "extensions": [".pdf", ".docx", ".pptx", ".odt", ".txt", ".md", ".png", ".jpg", ".jpeg", ".zip"],
